# Vision models, asked in this order: Gemini Flash-Lite, GPT-6 Luna,
# GPT-6 Sol, Claude Sonnet. At least one key is required; any model
# without a key is skipped.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Neon/Vercel Postgres connection string. Optional: without it,
# verification still works, results just aren't saved to history.
DATABASE_URL=
